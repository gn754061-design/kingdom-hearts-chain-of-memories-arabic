    "jiminy_text:gJiminyRikuStoryTale1Line39": "فهل سيرى عالم النور{END}",
    "jiminy_text:gJiminyRikuStoryTale1Line40": "مجدداً؟{END}",
    "jiminy_text:gJiminyRikuStoryTale4Line0": "أخذ فاكسين نسخته{END}",
    "jiminy_text:gJiminyRikuStoryTale4Line1": "أخذ فاكسين نسخته من ريكو{END}",
    "jiminy_text:gJiminyRikuStoryTale4Line2": "واتجه إلى السطح، لكنه سقط{END}",
    "jiminy_text:gJiminyRikuStoryTale4Line3": "في النهاية على يد سورا.{END}",
    "jiminy_text:gJiminyRikuStoryTale4Line4": "واجه ليكسيوس ريكو{END}",
    "jiminy_text:gJiminyRikuStoryTale4Line5": "ليكسيوس واجه ريكو،{END}",
    "jiminy_text:gJiminyRikuStoryTale4Line6": "ساعياً لإخضاعه للظلام.{END}",
    "jiminy_text:gJiminyRikuStoryTale4Line7": "لكن ريكو صمد وثبت.{END}",
    "jiminy_text:gJiminyRikuStoryTale4Line8": "{END}",
    "jiminy_text:gJiminyRikuStoryTale4Line9": " {END}",
    "jiminy_text:gJiminyRikuStoryTale4Line10": "ليكسايوس{END}",
