   ],
   "lines": 3
  },
  {
   "id": "card_message_text:gGoofyTalkText09",
   "pool": "card_message_text",
   "symbol": "gGoofyTalkText09",
   "en": "See how much you remember!\nIt can’t be long before her\nname comes back to you, too.{END}",
   "max_units": 90,
