   "lines": 2
  },
  {
   "id": "card_message_text:gGoofyTalkText15",
   "pool": "card_message_text",
   "symbol": "gGoofyTalkText15",
   "en": "Once you help Riku get his\nmemories back, you’ll make up\nin no time.{END}",
