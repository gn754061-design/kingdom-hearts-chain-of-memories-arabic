    "jiminy_text:gJiminyCharacterGeppettoLine4": " {END}",
    "jiminy_text:gJiminyCharacterGeppettoLine5": "ابتلع مونسترو جيبيتو،{END}",
    "jiminy_text:gJiminyCharacterGeppettoLine6": "والقارب وكل شيء، بينما{END}",
    "jiminy_text:gJiminyCharacterGeppettoLine7": "كان يبحث عن بينوكيو.{END}",
    "jiminy_text:gJiminyCharacterGeppettoLine8": "{END}",
