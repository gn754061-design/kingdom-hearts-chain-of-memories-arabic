   "max_units": 54,
   "units": 54,
   "controls": [
    "{END}"
   ],
   "lines": 2
  },
  {
   "id": "event_text:gEvent121Text21",
   "pool": "event_text",
   "symbol": "gEvent121Text21",
   "en": "The more the merrier!{END}",
   "max_units": 52,
   "units": 26,
   "controls": [
    "{END}"
   ],
   "lines": 1
  },
  {
   "id": "event_text:gEvent121Text22",
   "pool": "event_text",
   "symbol": "gEvent121Text22",
