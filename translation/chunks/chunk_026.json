   "max_units": 52,
   "units": 28,
   "controls": [
    "{END}"
   ],
   "lines": 1
  },
  {
   "id": "event_text:gEvent121Text26",
   "pool": "event_text",
   "symbol": "gEvent121Text26",
   "en": "Whatever.{END}",
   "max_units": 52,
   "units": 14,
   "controls": [
    "{END}"
   ],
   "lines": 1
  },
  {
   "id": "event_text:gEvent121Text27",
   "pool": "event_text",
   "symbol": "gEvent121Text27",
   "en": "Okay, let’s get this show on\nthe road!  But first I gotta\nexplain a few rules.{END}",
   "max_units": 85,
   "units": 85,
   "controls": [
    "{END}"
   ],
   "lines": 3
  },
  {
   "id": "event_text:gEvent121Text28",
   "pool": "event_text",
   "symbol": "gEvent121Text28",
   "en": "Rule #1!\nFirst one through the\nobstacle course wins!{END}",
   "max_units": 59,
   "units": 59,
   "controls": [
    "{END}"
   ],
   "lines": 3
  },
  {
   "id": "event_text:gEvent121Text29",
   "pool": "event_text",
   "symbol": "gEvent121Text29",
   "en": "Rule #2!\nIn the event of a tie, a battle\nwill determine the winner!{END}",
   "max_units": 74,
   "units": 74,
   "controls": [
    "{END}"
   ],
   "lines": 3
  },
  {
   "id": "event_text:gEvent121Text30",
   "pool": "event_text",
   "symbol": "gEvent121Text30",
   "en": "Rule #3!\nYou can interfere with your \nopponents on the course!{END}",
   "max_units": 69,
   "units": 69,
   "controls": [
    "{END}"
   ],
   "lines": 3
  },
  {
   "id": "event_text:gEvent121Text31",
   "pool": "event_text",
   "symbol": "gEvent121Text31",
