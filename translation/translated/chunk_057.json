{
  "translations": {
    "jiminy_text:gJiminyBlankLine": " {END}",
    "jiminy_text:gJiminyStoryTale1Line0": "قد يكون أصدقاؤنا{END}",
    "jiminy_text:gJiminyStoryTale1Line1": "هنا...{END}",
    "jiminy_text:gJiminyStoryTale1Line2": " {END}",
    "jiminy_text:gJiminyStoryTale1Line3": "كانت تلك الفكرة{END}",
    "jiminy_text:gJiminyStoryTale1Line4": "التي قادتنا إلى قلعة{END}",
    "jiminy_text:gJiminyStoryTale1Line5": "النسيان، حيث البطاقات{END}",
    "jiminy_text:gJiminyStoryTale1Line6": "تحكم كل شيء.{END}",
    "jiminy_text:gJiminyStoryTale1Line7": " {END}",
    "jiminy_text:gJiminyStoryTale1Line8": "رجل غامض أعطى{END}",
    "jiminy_text:gJiminyStoryTale1Line9": "سورا بطاقة، وبها{END}",
    "jiminy_text:gJiminyStoryTale1Line10": "أخذتنا إلى بلدة العبور{END}",
    "jiminy_text:gJiminyStoryTale1Line11": "من بين كل الأماكن!{END}",
    "jiminy_text:gJiminyStoryTale1Line12": " {END}",
    "jiminy_text:gJiminyStoryTale1Line13": "اتضح أن البلدة{END}",
    "jiminy_text:gJiminyStoryTale1Line14": "كانت مجرد نسج من{END}",
    "jiminy_text:gJiminyStoryTale1Line15": "ذكرياتنا الخاصة،{END}",
    "jiminy_text:gJiminyStoryTale1Line16": "العالم الأول{END}",
    "jiminy_text:gJiminyStoryTale1Line17": "منmany{END}",
    "jiminy_text:gJiminyStoryTale1Line18": " {END}",
    "jiminy_text:gJiminyStoryTale1Line19": "وهكذا تبدأ رحلتنا{END}",
    "jiminy_text:gJiminyStoryTale1Line20": "عبر هذه العوالم.{END}",
    "jiminy_text:gJiminyStoryTale1Line21": " {END}",
    "jiminy_text:gJiminyStoryTale2Line0": "يبدو أننا نفقد{END}",
    "jiminy_text:gJiminyStoryTale2Line1": "ذكرياتنا ببطء لما حدث{END}",
    "jiminy_text:gJiminyStoryTale2Line2": "قبل القلعة. وملاحظاتي{END}",
    "jiminy_text:gJiminyStoryTale2Line3": "عن الرحلة الأخيرة اختفت!{END}",
    "jiminy_text:gJiminyStoryTale2Line4": " {END}",
    "jiminy_text:gJiminyStoryTale2Line5": "لكن في المقابل، سورا{END}",
    "jiminy_text:gJiminyStoryTale2Line6": "يتذكر أشياء أخرى{END}",
    "jiminy_text:gJiminyStoryTale2Line7": "لا بد أنه نسيها حتى الآن―{END}",
    "jiminy_text:gJiminyStoryTale2Line8": "مثل فتاة كان يعرفها{END}",
    "jiminy_text:gJiminyStoryTale2Line9": "عندما كان صغيراً.{END}",
    "jiminy_text:gJiminyStoryTale2Line10": " {END}",
    "jiminy_text:gJiminyStoryTale2Line11": "بينما قاتلنا لاركسين، تذكر{END}",
    "jiminy_text:gJiminyStoryTale2Line12": "اسم الفتاة أخيراً...{END}",
    "jiminy_text:gJiminyStoryTale2Line13": " {END}",
    "jiminy_text:gJiminyStoryTale2Line14": "ناميني.{END}",
    "jiminy_text:gJiminyStoryTale2Line15": " {END}",
    "jiminy_text:gJiminyStoryTale2Line16": "إذن ذكريات سورا عن{END}",
    "jiminy_text:gJiminyStoryTale2Line17": "ناميني كانت زائفة...{END}",
    "jiminy_text:gJiminyStoryTale2Line18": " {END}",
    "jiminy_text:gJiminyStoryTale4Line0": "إذن ذكريات سورا عن{END}",
    "jiminy_text:gJiminyStoryTale4Line1": "ناميني كانت زائفة...{END}",
    "jiminy_text:gJiminyStoryTale4Line2": " {END}",
    "jiminy_text:gJiminyStoryTale4Line3": "أراد مارلوكسيا قلب سورا{END}",
    "jiminy_text:gJiminyStoryTale4Line4": "والقوة بداخله، فاستخدم{END}",
    "jiminy_text:gJiminyStoryTale4Line5": "ناميني لتزييف الذكريات{END}",
    "jiminy_text:gJiminyStoryTale4Line6": "ووضعها في قلب سورا.{END}",
    "jiminy_text:gJiminyStoryTale4Line7": " {END}",
    "jiminy_text:gJiminyStoryTale4Line8": "لاركسين رحلت، نذهب{END}",
    "jiminy_text:gJiminyStoryTale4Line9": "إلى القمة لإنهائه.{END}",
    "jiminy_text:gJiminyStoryTale4Line10": "نريد استعادة ذكرياتنا.{END}",
    "jiminy_text:gJiminyStoryTale4Line11": " {END}",
    "jiminy_text:gJiminyStoryTale4Line12": "وسورا― يريد الوفاء بالوعد{END}",
    "jiminy_text:gJiminyStoryTale4Line13": "الذي يتذكره. ناميني قد{END}",
    "jiminy_text:gJiminyStoryTale4Line14": "ليست صديقته، لكن في{END}",
    "jiminy_text:gJiminyStoryTale4Line15": "قلبه، حمايتها كل شيء.{END}",
    "jiminy_text:gJiminyStoryTale4Line16": "وسورا― يريد{END}",
    "jiminy_text:gJiminyStoryTale4Line17": "الوفاء بالوعد{END}",
    "jiminy_text:gJiminyStoryTale4Line18": "الذي يتذكره.{END}",
    "jiminy_text:gJiminyStoryTale4Line19": "ناميني ليست صديقته، لكن{END}",
    "jiminy_text:gJiminyStoryTale4Line20": "في قلبه، حمايتها{END}",
    "jiminy_text:gJiminyStoryTale4Line21": "هي الخيار الوحيد.{END}",
    "jiminy_text:gJiminyStoryOlympusColiseumLine0": "أراد سورا مواجهة هرقل{END}",
    "jiminy_text:gJiminyStoryOlympusColiseumLine1": "في المباريات.{END}",
    "jiminy_text:gJiminyStoryOlympusColiseumLine2": " {END}",
    "jiminy_text:gJiminyStoryOlympusColiseumLine3": "قررنا المنافسة{END}",
    "jiminy_text:gJiminyStoryOlympusColiseumLine4": "في المباريات.{END}",
    "jiminy_text:gJiminyStoryOlympusColiseumLine5": " {END}"
  }
}