{
 "translations": {
  "jiminy_text:gJiminyCharacterSoraLine2": "سورا اختاره مفتاح القلب{END}",
  "jiminy_text:gJiminyCharacterSoraLine3": "لمحاربة فاقدي القلوب.{END}",
  "jiminy_text:gJiminyCharacterSoraLine4": " {END}",
  "jiminy_text:gJiminyCharacterSoraLine5": "كان سورا من هزم{END}",
  "jiminy_text:gJiminyCharacterSoraLine6": "أنسيم، منهِياً خططه لإغراق{END}",
  "jiminy_text:gJiminyCharacterSoraLine7": "العالم في الظلام.{END}",
  "jiminy_text:gJiminyCharacterSoraLine8": "{END}",
  "jiminy_text:gJiminyCharacterSoraLine9": " {END}",
  "jiminy_text:gJiminyCharacterSoraLine10": "ومع ذلك، يواصل سورا{END}",
  "jiminy_text:gJiminyCharacterSoraLine11": "رحلته{END}",
  "jiminy_text:gJiminyCharacterSoraLine12": "بحثاً{END}",
  "jiminy_text:gJiminyCharacterSoraLine13": "عن{END}",
  "jiminy_text:gJiminyCharacterSoraLine14": "الأصدقاء{END}",
  "jiminy_text:gJiminyCharacterDonaldDuckLine0": "الذين{END}",
  "jiminy_text:gJiminyCharacterDonaldDuckLine1": "فقدهم{END}",
  "jiminy_text:gJiminyCharacterDonaldDuckLine2": "في الصراع.{END}",
  "jiminy_text:gJiminyCharacterDonaldDuckLine3": "{END}",
  "jiminy_text:gJiminyCharacterDonaldDuckLine4": " {END}",
  "jiminy_text:gJiminyCharacterDonaldDuckLine5": "مزاجه الحاد يوقعه في{END}",
  "jiminy_text:gJiminyCharacterDonaldDuckLine6": "المشاكل أحياناً، لكنه{END}",
  "jiminy_text:gJiminyCharacterDonaldDuckLine7": "شجاع جداً.{END}",
  "jiminy_text:gJiminyCharacterDonaldDuckLine8": "{END}",
  "jiminy_text:gJiminyCharacterDonaldDuckLine9": " {END}",
  "jiminy_text:gJiminyCharacterDonaldDuckLine10": "دونالد يبحث حالياً عن{END}",
  "jiminy_text:gJiminyCharacterDonaldDuckLine11": "أدلة{END}",
  "jiminy_text:gJiminyCharacterDonaldDuckLine12": "لما{END}",
  "jiminy_text:gJiminyCharacterDonaldDuckLine13": "حدث{END}",
  "jiminy_text:gJiminyCharacterDonaldDuckLine14": "للملك{END}",
  "jiminy_text:gJiminyCharacterDonaldDuckLine15": "بعد{END}",
  "jiminy_text:gJiminyCharacterGoofyLine0": "أن{END}",
  "jiminy_text:gJiminyCharacterGoofyLine1": "حُبس{END}",
  "jiminy_text:gJiminyCharacterGoofyLine2": "خلف{END}",
  "jiminy_text:gJiminyCharacterGoofyLine3": "باب الظلام.{END}",
  "jiminy_text:gJiminyCharacterGoofyLine4": "{END}",
  "jiminy_text:gJiminyCharacterGoofyLine5": " {END}",
  "jiminy_text:gJiminyCharacterGoofyLine6": "إنه مرح وهادئ، ولا أحد أكثر{END}",
  "jiminy_text:gJiminyCharacterGoofyLine7": "إخلاصاً للملك.{END}",
  "jiminy_text:gJiminyCharacterGoofyLine8": "{END}",
  "jiminy_text:gJiminyCharacterGoofyLine9": " {END}",
  "jiminy_text:gJiminyCharacterGoofyLine10": "غوفي{END}",
  "jiminy_text:gJiminyCharacterGoofyLine11": "وسورا{END}",
  "jiminy_text:gJiminyCharacterJiminyCricketLine0": "صديقان{END}",
  "jiminy_text:gJiminyCharacterJiminyCricketLine1": "مقربان جداً.{END}",
  "jiminy_text:gJiminyCharacterJiminyCricketLine2": "{END}",
  "jiminy_text:gJiminyCharacterJiminyCricketLine3": " {END}",
  "jiminy_text:gJiminyCharacterJiminyCricketLine4": "أعمل{END}",
  "jiminy_text:gJiminyCharacterJiminyCricketLine5": "أيضاً{END}",
  "jiminy_text:gJiminyCharacterJiminyCricketLine6": "كضمير{END}",
  "jiminy_text:gJiminyCharacterRikuLine0": "لبينوكيو،{END}",
  "jiminy_text:gJiminyCharacterRikuLine2": "ليعرف{END}",
  "jiminy_text:gJiminyCharacterRikuLine3": "الصواب{END}",
  "jiminy_text:gJiminyCharacterRikuLine4": "من الخطأ.{END}",
  "jiminy_text:gJiminyCharacterRikuLine5": "{END}",
  "jiminy_text:gJiminyCharacterRikuLine6": " {END}",
  "jiminy_text:gJiminyCharacterRikuLine7": "لإغلاق باب الظلام، بقي{END}",
  "jiminy_text:gJiminyCharacterRikuLine8": "ريكو مع الملك على الجانب{END}",
  "jiminy_text:gJiminyCharacterRikuLine9": "الآخر. مكانته{END}",
  "jiminy_text:gJiminyCharacterRikuLine10": "الحالية{END}",
  "jiminy_text:gJiminyCharacterRikuLine11": "غير معروفة.{END}",
  "jiminy_text:gJiminyCharacterRikuLine12": "{END}",
  "jiminy_text:gJiminyCharacterRikuLine13": " {END}",
  "jiminy_text:gJiminyCharacterRikuLine14": "يسافر سورا أملاً{END}",
  "jiminy_text:gJiminyCharacterRikuLine15": "في{END}",
  "jiminy_text:gJiminyCharacterSimbaLine0": "العثور{END}",
  "jiminy_text:gJiminyCharacterSimbaLine1": "على ريكو.{END}",
  "jiminy_text:gJiminyCharacterSimbaLine2": "{END}",
  "jiminy_text:gJiminyCharacterSimbaLine3": " {END}",
  "jiminy_text:gJiminyCharacterSimbaLine4": "يكفي أن ينادي سورا وسيظهر{END}",
  "jiminy_text:gJiminyCharacterSimbaLine5": "سمبا ويمنحه قوته.{END}",
  "jiminy_text:gJiminyCharacterSimbaLine6": "{END}"
 }
}