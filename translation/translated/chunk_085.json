    "jiminy_text:gJiminyRikuStoryTale1Line19": "{END}",
    "jiminy_text:gJiminyRikuStoryTale1Line20": "قوة الظلام، ولكن كلما{END}",
    "jiminy_text:gJiminyRikuStoryTale1Line21": "استخدمها زادت سطوتها{END}",
    "jiminy_text:gJiminyRikuStoryTale1Line22": "على قلبه.{END}",
    "jiminy_text:gJiminyRikuStoryTale1Line23": " {END}",
    "jiminy_text:gJiminyRikuStoryTale1Line24": "المفقودة{END}",
    "jiminy_text:gJiminyRikuStoryTale1Line25": "كايري،{END}",
