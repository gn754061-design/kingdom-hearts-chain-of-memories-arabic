    "jiminy_text:gJiminyRikuStoryTale1Line27": "{END}",
    "jiminy_text:gJiminyRikuStoryTale1Line28": "{END}",
    "jiminy_text:gJiminyRikuStoryTale1Line29": " {END}",
    "jiminy_text:gJiminyRikuStoryTale1Line30": "لكن{END}",
    "jiminy_text:gJiminyRikuStoryTale1Line31": "ماليفيسنت{END}",
    "jiminy_text:gJiminyRikuStoryTale1Line32": "{END}",
    "jiminy_text:gJiminyRikuStoryTale1Line33": "{END}",
