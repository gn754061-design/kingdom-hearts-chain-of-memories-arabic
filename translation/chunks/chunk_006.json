   "lines": 3
  },
  {
   "id": "card_message_text:gDonaldTalkText17",
   "pool": "card_message_text",
   "symbol": "gDonaldTalkText17",
   "en": "Careful!\nYou never know where Riku\nmight be hiding!{END}",
   "max_units": 80,
   "units": 58,
   "controls": [
