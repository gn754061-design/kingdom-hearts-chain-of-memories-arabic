   "max_units": 89,
   "units": 89,
   "controls": [
    "{END}"
   ],
   "lines": 3
  },
  {
   "id": "event_text:gEvent121Text19",
   "pool": "event_text",
   "symbol": "gEvent121Text19",
   "en": "They’re not.{END}",
   "max_units": 52,
   "units": 17,
   "controls": [
    "{END}"
   ],
   "lines": 1
  },
  {
   "id": "event_text:gEvent121Text20",
   "pool": "event_text",
   "symbol": "gEvent121Text20",
