   "max_units": 80,
   "units": 60,
   "controls": [
    "{END}"
   ],
   "lines": 2
  },
  {
   "id": "card_message_text:gDonaldTalkText10",
   "pool": "card_message_text",
   "symbol": "gDonaldTalkText10",
