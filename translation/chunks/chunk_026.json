   "max_units": 74,
   "units": 74,
   "controls": [
    "{END}"
   ],
   "lines": 3
  },
  {
   "id": "event_text:gEvent121Text17",
   "pool": "event_text",
   "symbol": "gEvent121Text17",
   "en": "It’s Sora―not “kid.”{END}",
   "max_units": 52,
   "units": 25,
   "controls": [
    "{END}"
   ],
   "lines": 1
  },
  {
   "id": "event_text:gEvent121Text18",
   "pool": "event_text",
   "symbol": "gEvent121Text18",
