   "lines": 1
  },
  {
   "id": "event_text:gEvent021Text11",
   "pool": "event_text",
   "symbol": "gEvent021Text11",
   "en": "I feel kinda dumb.\nHere we are, saying we won’t\nforget our friends…{END}",
   "max_units": 74,
