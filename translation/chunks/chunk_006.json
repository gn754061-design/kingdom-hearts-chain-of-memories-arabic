   "en": "That Riku is so stubborn!\nHas he always been like that?{END}",
   "max_units": 80,
   "units": 61,
   "controls": [
    "{END}"
   ],
   "lines": 2
  },
  {
   "id": "card_message_text:gDonaldTalkText16",
   "pool": "card_message_text",
   "symbol": "gDonaldTalkText16",
   "en": "Kai… Kai… Wak?!\nThat’s weird.  I can’t think of\nher name.{END}",
