   "controls": [
    "{END}"
   ],
   "lines": 3
  },
  {
   "id": "event_text:gEvent121Text14",
   "pool": "event_text",
   "symbol": "gEvent121Text14",
   "en": "Is that right?{END}",
   "max_units": 52,
   "units": 19,
   "controls": [
    "{END}"
   ],
   "lines": 1
  },
  {
   "id": "event_text:gEvent121Text15",
   "pool": "event_text",
   "symbol": "gEvent121Text15",
   "en": "Then it’s settled!  Let us\ncompete, and you won’t have\nto cancel the games!\nHow about it, Phil?{END}",
