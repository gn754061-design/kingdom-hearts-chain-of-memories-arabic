   "controls": [
    "{END}"
   ],
   "lines": 3
  },
  {
   "id": "card_message_text:gGoofyTalkText10",
   "pool": "card_message_text",
   "symbol": "gGoofyTalkText10",
   "en": "Don’t you just hate it when\nsomething’s on the tip of your\ntongue?{END}",
