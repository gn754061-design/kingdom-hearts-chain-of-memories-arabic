   "symbol": "gEvent089Text21",
   "en": "Leave it to me!{END}",
   "max_units": 52,
   "units": 20,
   "controls": [
    "{END}"
   ],
   "lines": 1
  },
  {
   "id": "event_text:gEvent089Text22",
   "pool": "event_text",
   "symbol": "gEvent089Text22",
