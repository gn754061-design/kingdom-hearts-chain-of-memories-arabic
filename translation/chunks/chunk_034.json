   "units": 34,
   "controls": [
    "{END}"
   ],
   "lines": 1
  },
  {
   "id": "event_text:gEvent025Text01",
   "pool": "event_text",
   "symbol": "gEvent025Text01",
   "en": "Ooh, aren’t you clever.\nThe name’s Larxene.{END}",
   "max_units": 52,
   "units": 49,
   "controls": [
    "{END}"
   ],
   "lines": 2
  },
  {
   "id": "event_text:gEvent025Text02",
   "pool": "event_text",
   "symbol": "gEvent025Text02",
