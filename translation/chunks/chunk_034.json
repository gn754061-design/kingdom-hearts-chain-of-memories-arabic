   "units": 53,
   "controls": [
    "{END}"
   ],
   "lines": 2
  },
  {
   "id": "event_text:gEvent025Text03",
   "pool": "event_text",
   "symbol": "gEvent025Text03",
   "en": "I bet it’s nice to peel all the\nworthless memories away…\n\n…and awaken the true\nmemories that lie deep in your\nheart.{END}",
   "max_units": 126,
   "units": 126,
   "controls": [
    "{END}"
   ],
   "lines": 6
  },
  {
   "id": "event_text:gEvent025Text04",
   "pool": "event_text",
   "symbol": "gEvent025Text04",
   "en": "True memories?{END}",
   "max_units": 52,
   "units": 19,
   "controls": [
    "{END}"
   ],
   "lines": 1
  },
  {
   "id": "event_text:gEvent025Text05",
   "pool": "event_text",
   "symbol": "gEvent025Text05",
   "en": "But you’re still forgetting\nsomething, aren’t you, Sora?\nThe most important thing.{END}",
