{
 "translations": {
  "jiminy_text:gJiminyStoryOlympusColiseumLine6": "للتخلص من هرقل، وظف{END}",
  "jiminy_text:gJiminyStoryOlympusColiseumLine7": "كلاود للقضاء عليه. تعاون{END}",
  "jiminy_text:gJiminyStoryOlympusColiseumLine8": "كلاود ظناً أنه{END}",
  "jiminy_text:gJiminyStoryOlympusColiseumLine9": "سيستعيد ذكرياته.{END}",
  "jiminy_text:gJiminyStoryOlympusColiseumLine10": "{END}",
  "jiminy_text:gJiminyStoryOlympusColiseumLine11": " {END}",
  "jiminy_text:gJiminyStoryOlympusColiseumLine12": "لكن حتى كلاود لم يستطع{END}",
  "jiminy_text:gJiminyStoryOlympusColiseumLine13": "هزيمة هرقل. تدخل هادس{END}",
  "jiminy_text:gJiminyStoryOlympusColiseumLine14": "لإنهاء الأمر، لكننا{END}",
  "jiminy_text:gJiminyStoryOlympusColiseumLine15": "أوقفنا خططه. أحضر علاء{END}",
  "jiminy_text:gJiminyStoryOlympusColiseumLine16": "الدين المصباح السحري من{END}",
  "jiminy_text:gJiminyStoryAgrabahLine0": "كهف العجائب، أملاً{END}",
  "jiminy_text:gJiminyStoryAgrabahLine1": "في{END}",
  "jiminy_text:gJiminyStoryAgrabahLine2": "لقاء{END}",
  "jiminy_text:gJiminyStoryAgrabahLine3": "ياسمين،{END}",
  "jiminy_text:gJiminyStoryAgrabahLine4": "أميرة أگراباه.{END}",
  "jiminy_text:gJiminyStoryAgrabahLine5": "{END}",
  "jiminy_text:gJiminyStoryAgrabahLine6": " {END}",
  "jiminy_text:gJiminyStoryAgrabahLine7": "داخل المصباح كان الجني،{END}",
  "jiminy_text:gJiminyStoryAgrabahLine8": "الذي يمنح ثلاث أمنيات لمن{END}",
  "jiminy_text:gJiminyStoryAgrabahLine9": "يحمل المصباح.{END}",
  "jiminy_text:gJiminyStoryAgrabahLine10": "{END}",
  "jiminy_text:gJiminyStoryAgrabahLine11": " {END}",
  "jiminy_text:gJiminyStoryAgrabahLine12": "أمل علاء الدين أن{END}",
  "jiminy_text:gJiminyStoryAgrabahLine13": "يصبح أميراً ليرى ياسمين{END}",
  "jiminy_text:gJiminyStoryAgrabahLine14": "متى شاء. لكنه استخدم{END}",
  "jiminy_text:gJiminyStoryAgrabahLine15": "أمنيتين في محاربة فاقدي{END}",
  "jiminy_text:gJiminyStoryAgrabahLine16": "القلوب، ثم{END}",
  "jiminy_text:gJiminyStoryAgrabahLine17": "سرق{END}",
  "jiminy_text:gJiminyStoryAgrabahLine18": "جعفر المصباح.{END}",
  "jiminy_text:gJiminyStoryAgrabahLine19": "{END}",
  "jiminy_text:gJiminyStoryAgrabahLine20": " {END}",
  "jiminy_text:gJiminyStoryAgrabahLine21": "تحول جعفر إلى جني،{END}",
  "jiminy_text:gJiminyStoryAgrabahLine22": "لكننا هزمناه{END}",
  "jiminy_text:gJiminyStoryAgrabahLine23": "واستعدنا المصباح.{END}",
  "jiminy_text:gJiminyStoryAgrabahLine24": "{END}",
  "jiminy_text:gJiminyStoryAgrabahLine25": " {END}",
  "jiminy_text:gJiminyStoryAgrabahLine26": "بدلاً من أن يصبح أميراً،{END}",
  "jiminy_text:gJiminyStoryAgrabahLine27": "استخدم علاء الدين أمنيته{END}",
  "jiminy_text:gJiminyStoryAgrabahLine28": "الأخيرة لتحرير الجني، وقرر{END}",
  "jiminy_text:gJiminyStoryAgrabahLine29": "أن يريد أن تعرفه ياسمين{END}",
  "jiminy_text:gJiminyStoryAgrabahLine30": "على حقيقته. خرج{END}",
  "jiminy_text:gJiminyStoryAgrabahLine31": "جيبيتو بحثاً عن بينوكيو{END}",
  "jiminy_text:gJiminyStoryMonstroLine0": "وابتلعه الحوت{END}",
  "jiminy_text:gJiminyStoryMonstroLine1": "مونسترو. لكن العثور على{END}",
  "jiminy_text:gJiminyStoryMonstroLine2": "بينوكيو{END}",
  "jiminy_text:gJiminyStoryMonstroLine3": "بالداخل{END}",
  "jiminy_text:gJiminyStoryMonstroLine4": "ملأه بالفرح.{END}",
  "jiminy_text:gJiminyStoryMonstroLine5": "{END}",
  "jiminy_text:gJiminyStoryMonstroLine6": " {END}",
  "jiminy_text:gJiminyStoryMonstroLine7": "لكن بينوكيو شعر بالسوء{END}",
  "jiminy_text:gJiminyStoryMonstroLine8": "للهروب من البيت وتعريض{END}",
  "jiminy_text:gJiminyStoryMonstroLine9": "أبيه للخطر، لذلك انطلق{END}",
  "jiminy_text:gJiminyStoryMonstroLine10": "ليجد طريقاً للخروج{END}",
  "jiminy_text:gJiminyStoryMonstroLine11": "من مونسترو.{END}",
  "jiminy_text:gJiminyStoryMonstroLine12": "{END}",
  "jiminy_text:gJiminyStoryMonstroLine13": " {END}",
  "jiminy_text:gJiminyStoryMonstroLine14": "بعد مواجهة فاقد قلب كبير،{END}",
  "jiminy_text:gJiminyStoryMonstroLine15": "كانت لدى بينوكيو فكرة رائعة:{END}",
  "jiminy_text:gJiminyStoryMonstroLine16": "لماذا لا نحدث ضجة ونتسبب{END}",
  "jiminy_text:gJiminyStoryMonstroLine17": "في{END}",
  "jiminy_text:gJiminyStoryMonstroLine18": "بصقنا خارجاً؟{END}",
  "jiminy_text:gJiminyStoryMonstroLine19": "{END}",
  "jiminy_text:gJiminyStoryMonstroLine20": " {END}",
  "jiminy_text:gJiminyStoryMonstroLine21": "بمساعدتنا، نجحت الخطة، وهرب{END}",
  "jiminy_text:gJiminyStoryMonstroLine22": "بينوكيو وجيبيتو بسلام.{END}",
  "jiminy_text:gJiminyStoryMonstroLine23": "بيتر بان اختبأ في{END}",
  "jiminy_text:gJiminyStoryMonstroLine24": "سفينة{END}",
  "jiminy_text:gJiminyStoryNeverLandLine0": "الكابتن هوك{END}",
  "jiminy_text:gJiminyStoryNeverLandLine1": "{END}"
 }
}