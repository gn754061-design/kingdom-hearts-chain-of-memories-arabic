    "jiminy_text:gJiminyCharacterDrFinkelsteinLine3": "{END}",
    "jiminy_text:gJiminyCharacterDrFinkelsteinLine4": " {END}",
    "jiminy_text:gJiminyCharacterDrFinkelsteinLine5": "هذه المرة، صنع الدكتور{END}",
    "jiminy_text:gJiminyCharacterDrFinkelsteinLine6": "فينكلشتاين جرعة لاستعادة{END}",
    "jiminy_text:gJiminyCharacterDrFinkelsteinLine7": "الذكريات الحقيقية،{END}",
    "jiminy_text:gJiminyCharacterDrFinkelsteinLine8": "لكن{END}",
    "jiminy_text:gJiminyCharacterDrFinkelsteinLine9": "أوجي{END}",
    "jiminy_text:gJiminyCharacterOogieBoogieLine0": "بوجي شربها.{END}",
