  },
  {
   "id": "card_message_text:gGoofyTalkText08",
   "pool": "card_message_text",
   "symbol": "gGoofyTalkText08",
   "en": "Something or another is bound\nto make you remember your\nfriend’s name.{END}",
   "max_units": 80,
   "units": 77,
   "controls": [
