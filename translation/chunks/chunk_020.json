   ],
   "lines": 3
  },
  {
   "id": "event_text:gEvent098Text06",
   "pool": "event_text",
   "symbol": "gEvent098Text06",
   "en": "I sentence you to…{END}",
   "max_units": 52,
   "units": 23,
   "controls": [
