    "jiminy_text:gJiminyCharacterPinocchioLine3": " {END}",
    "jiminy_text:gJiminyCharacterPinocchioLine4": "ليصبح ولداً حقيقياً، على{END}",
    "jiminy_text:gJiminyCharacterPinocchioLine5": "بينوكيو أن يتعلم الشجاعة{END}",
