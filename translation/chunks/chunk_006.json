   "lines": 2
  },
  {
   "id": "card_message_text:gDonaldTalkText19",
   "pool": "card_message_text",
   "symbol": "gDonaldTalkText19",
   "en": "Another side of your heart?\nIs that where the stuff you\nforget goes?{END}",
