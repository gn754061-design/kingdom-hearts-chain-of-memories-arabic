    "event_name_text:gEventName009": "１Ｆ　Ｔｒａｖｅｒｓｅ　Ｔｏｗｎ　Ｅ４　　　　　　{END}",
    "event_name_text:gEventName008": "１Ｆ　Ｂａｔｔｌｅ　ＧｕａｒｄＡｒｍｏｒ　　　　　{END}",
