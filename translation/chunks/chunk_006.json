    "{PLAIN}"
   ],
   "lines": 3
  },
  {
   "id": "card_message_text:gMapSelectValueTutorialText1",
   "pool": "card_message_text",
   "symbol": "gMapSelectValueTutorialText1",
   "en": "The criterion displayed now\nmeans that the door will open\nwith a value of 1 or greater.{END}",
   "max_units": 94,
