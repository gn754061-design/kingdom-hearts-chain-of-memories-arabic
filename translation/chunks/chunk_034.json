   "max_units": 52,
   "units": 10,
   "controls": [
    "{END}"
   ],
   "lines": 1
  },
  {
   "id": "event_text:gEvent026Text03",
   "pool": "event_text",
   "symbol": "gEvent026Text03",
   "en": "What’s…that?\nIs that mine?{END}",
   "max_units": 52,
   "units": 32,
   "controls": [
    "{END}"
   ],
   "lines": 2
  },
  {
   "id": "event_text:gEvent026Text04",
   "pool": "event_text",
   "symbol": "gEvent026Text04",
