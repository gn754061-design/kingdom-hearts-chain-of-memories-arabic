{
 "translations": {
  "jiminy_text:gJiminyRikuStoryTale2Line5": " {END}",
  "jiminy_text:gJiminyRikuStoryTale2Line6": "قيل لريكو إنه لأنه رفض{END}",
  "jiminy_text:gJiminyRikuStoryTale2Line7": "الأشياء الأخرى في حياته{END}",
  "jiminy_text:gJiminyRikuStoryTale2Line8": "ليدعي الظلام، فإن قلبه الآن{END}",
  "jiminy_text:gJiminyRikuStoryTale2Line9": "خالٍ إلا من الظلام{END}",
  "jiminy_text:gJiminyRikuStoryTale2Line10": "الذي{END}",
  "jiminy_text:gJiminyRikuStoryTale2Line11": "سعى إليه.{END}",
  "jiminy_text:gJiminyRikuStoryTale2Line12": "{END}",
  "jiminy_text:gJiminyRikuStoryTale2Line13": " {END}",
  "jiminy_text:gJiminyRikuStoryTale2Line14": "غير قادر على قبول هذا،{END}",
  "jiminy_text:gJiminyRikuStoryTale2Line15": "التقى ريكو بأنسيم،{END}",
  "jiminy_text:gJiminyRikuStoryTale2Line16": "الذي حاول مرة أخرى{END}",
  "jiminy_text:gJiminyRikuStoryTale2Line17": "السيطرة عليه.{END}",
  "jiminy_text:gJiminyRikuStoryTale2Line18": " {END}",
  "jiminy_text:gJiminyRikuStoryTale2Line19": "تدخل الملك لإنقاذ ريكو،{END}",
  "jiminy_text:gJiminyRikuStoryTale2Line20": "لكن أنسيم لم يتخل{END}",
  "jiminy_text:gJiminyRikuStoryTale2Line21": "عن قلبه.{END}",
  "jiminy_text:gJiminyRikuStoryTale2Line22": "{END}",
  "jiminy_text:gJiminyRikuStoryTale2Line23": " {END}",
  "jiminy_text:gJiminyRikuStoryTale2Line24": "وعليه، على ريكو محاربة{END}",
  "jiminy_text:gJiminyRikuStoryTale2Line25": "الظلام في داخله. بينما{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line0": "يكافح الظلام في قلبه،{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line1": "التقى ريكو بشخص يشبهه{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line2": "تماماً، نسخة{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line3": "صنعها{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line4": "فاكسين،{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line5": "عضو المنظمة.{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line6": "{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line7": " {END}",
  "jiminy_text:gJiminyRikuStoryTale3Line8": "النسخة كانت تتحكم بالظلام{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line9": "بحرية، وتصف ريكو بالجبان{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line10": "لإهماله الظلام.{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line11": "{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line12": " {END}",
  "jiminy_text:gJiminyRikuStoryTale3Line13": "في هذه الأثناء، عملاء{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line14": "المنظمة أظهروا تنافسهم.{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line15": "يبدو أن سورا وريكو هما{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line16": "السبب في سيطرتهم على{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line17": "القلعة— لكن لماذا؟{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line18": "واحداً تلو الآخر، سقط{END}",
  "jiminy_text:gJiminyRikuStoryTale3Line19": "أعضاء المنظمة على يدي{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line0": "ريكو وسورا—{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line1": "حتى{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line2": "مارلوكسيا،{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line3": "سيد القلعة.{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line4": "{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line5": " {END}",
  "jiminy_text:gJiminyRikuStoryTale5Line6": "زيكسيون، أملاً في تجنب مصير{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line7": "مشابه، حاول استخدام ذكريات{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line8": "موطن ريكو ضده.{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line9": "{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line10": " {END}",
  "jiminy_text:gJiminyRikuStoryTale5Line11": "بعد أن تجاهله أصدقاؤه{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line12": "وهوجمه سورا، بدا أن ريكو{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line13": "سيجرف بالنور، لكن صوت{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line14": "كايري{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line15": "منحه الشجاعة.{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line16": "{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line17": " {END}",
  "jiminy_text:gJiminyRikuStoryTale5Line18": "لم يعد خائفاً من الظلام،{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line19": "رأى ريكو من خلال سورا{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line20": "المزيف وأحبط فخ زيكسيون.{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line21": "يتفاعل مع قوة الظلام. قوة{END}",
  "jiminy_text:gJiminyRikuStoryTale5Line22": "ريكو أعلى عندما{END}",
  "jiminy_text:gJiminyRikuCardSoulEaterLine0": "يستخدم الظلام في{END}",
  "jiminy_text:gJiminyRikuCardSoulEaterLine1": "القتال.{END}",
  "jiminy_text:gJiminyRikuCardSoulEaterLine2": "صبي{END}",
  "jiminy_text:gJiminyRikuCardSoulEaterLine3": "مشرق{END}",
  "jiminy_text:gJiminyCharacterSoraLine0": "وحيوي اختاره{END}",
  "jiminy_text:gJiminyCharacterSoraLine1": "{END}"
 }
}