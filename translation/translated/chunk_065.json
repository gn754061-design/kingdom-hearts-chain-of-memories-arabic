    "jiminy_text:gJiminyCharacterOogieBoogieLine2": " {END}",
    "jiminy_text:gJiminyCharacterOogieBoogieLine3": "سرق أوجي بوجي جرعة{END}",
    "jiminy_text:gJiminyCharacterOogieBoogieLine4": "الدكتور فينكلشتاين ظناً أنها{END}",
    "jiminy_text:gJiminyCharacterOogieBoogieLine5": "ستجعله أقوى، لكنها دفعته{END}",
    "jiminy_text:gJiminyCharacterOogieBoogieLine6": "إلى{END}",
    "jiminy_text:gJiminyCharacterOogieBoogieLine7": "الجنون{END}",
    "jiminy_text:gJiminyCharacterOogieBoogieLine8": "بالخوف{END}",
    "jiminy_text:gJiminyCharacterPinocchioLine0": "بدلاً{END}",
