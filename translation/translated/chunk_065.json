    "jiminy_text:gJiminyCharacterPinocchioLine7": "{END}",
    "jiminy_text:gJiminyCharacterPinocchioLine8": " {END}",
    "jiminy_text:gJiminyCharacterPinocchioLine9": "ابتلعته هو{END}",
    "jiminy_text:gJiminyCharacterPinocchioLine10": "وجيبيتو{END}",
    "jiminy_text:gJiminyCharacterPinocchioLine11": "مونسترو،{END}",
    "jiminy_text:gJiminyCharacterPinocchioLine12": "لكنهم{END}",
    "jiminy_text:gJiminyCharacterGeppettoLine0": "هربوا{END}",
    "jiminy_text:gJiminyCharacterGeppettoLine1": "بمساعدة{END}",
