{
  "translations": {
    "jiminy_text:gJiminyStoryNeverLandLine2": "لإنقاذ ويندي المخطوفة.{END}",
    "jiminy_text:gJiminyStoryNeverLandLine3": "{END}",
    "jiminy_text:gJiminyStoryNeverLandLine4": " {END}",
    "jiminy_text:gJiminyStoryNeverLandLine5": "لكن بمجرد إنقاذها، أخبرت{END}",
    "jiminy_text:gJiminyStoryNeverLandLine6": "ويندي بيتر أنها تريد{END}",
    "jiminy_text:gJiminyStoryNeverLandLine7": "العودة إلى لندن.{END}",
    "jiminy_text:gJiminyStoryNeverLandLine8": "{END}",
    "jiminy_text:gJiminyStoryNeverLandLine9": " {END}",
    "jiminy_text:gJiminyStoryNeverLandLine10": "هل ستكبر ويندي وتنساه{END}",
    "jiminy_text:gJiminyStoryNeverLandLine11": "وتنسى أرض الأحلام؟ لم{END}",
    "jiminy_text:gJiminyStoryNeverLandLine12": "يعجب بيتر ذلك،{END}",
    "jiminy_text:gJiminyStoryNeverLandLine13": "وغادر غاضباً.{END}",
    "jiminy_text:gJiminyStoryNeverLandLine14": "{END}",
    "jiminy_text:gJiminyStoryNeverLandLine15": " {END}",
    "jiminy_text:gJiminyStoryNeverLandLine16": "في هذه الأثناء، كنا{END}",
    "jiminy_text:gJiminyStoryNeverLandLine17": "نحاول النزول من السفينة.{END}",
    "jiminy_text:gJiminyStoryNeverLandLine18": "أمسك هوك بنا على ظهرها،{END}",
    "jiminy_text:gJiminyStoryNeverLandLine19": "لكن بيتر{END}",
    "jiminy_text:gJiminyStoryNeverLandLine20": "عاد وأنقذنا.{END}",
    "jiminy_text:gJiminyStoryNeverLandLine21": "{END}",
    "jiminy_text:gJiminyStoryNeverLandLine22": " {END}",
    "jiminy_text:gJiminyStoryNeverLandLine23": "في النهاية، ودع بيتر{END}",
    "jiminy_text:gJiminyStoryNeverLandLine24": "وويندي بعضهما، لكنهما{END}",
    "jiminy_text:gJiminyStoryNeverLandLine25": "وعدا باللقاء يوماً. جاء{END}",
    "jiminy_text:gJiminyStoryNeverLandLine26": "الوحش لإنقاذ بيل من براثن{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine0": "ماليفيسنت، لكنها{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine1": "تصرفت{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine2": "ببرود{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine3": "ولم{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine4": "تذهب معه.{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine5": "{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine6": " {END}",
    "jiminy_text:gJiminyStoryHollowBastionLine7": "شعرنا بالسوء لأجله، لذلك{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine8": "ذهبنا لرؤية بيل. اتضح{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine9": "أنها كانت تتظاهر فقط{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine10": "بالقسوة، لتحمي قلبها{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine11": "والحب بداخله{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine12": "من ماليفيسنت.{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine13": "{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine14": " {END}",
    "jiminy_text:gJiminyStoryHollowBastionLine15": "لكن عند الاختيار، لم تستطع{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine16": "بيل إخفاء مشاعرها تجاه{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine17": "الوحش، وسرقت{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine18": "ماليفيسنت قلبها.{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine19": "{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine20": " {END}",
    "jiminy_text:gJiminyStoryHollowBastionLine21": "مع الوحش، اعتنينا{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine22": "بماليفيسنت وأعدنا قلب بيل.{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine23": "البطاقة التي أعطانا{END}",
    "jiminy_text:gJiminyStoryHollowBastionLine24": "إياها فاكسين قادت إلى بلدة{END}",
    "jiminy_text:gJiminyStoryTwilightTownLine0": "لا يتذكرها{END}",
    "jiminy_text:gJiminyStoryTwilightTownLine1": "أحد منا.{END}",
    "jiminy_text:gJiminyStoryTwilightTownLine2": "{END}",
    "jiminy_text:gJiminyStoryTwilightTownLine3": " {END}",
    "jiminy_text:gJiminyStoryTwilightTownLine4": "لكن سورا تمسك بوعده{END}",
    "jiminy_text:gJiminyStoryTwilightTownLine5": "لناميني، وواصلنا التقدم.{END}",
    "jiminy_text:gJiminyStoryTwilightTownLine6": "{END}",
    "jiminy_text:gJiminyStoryTwilightTownLine7": " {END}",
    "jiminy_text:gJiminyStoryTwilightTownLine8": "وبالمناسبة، بدا فاكسين{END}",
    "jiminy_text:gJiminyStoryTwilightTownLine9": "مستعداً لقول شيء عن ذلك،{END}",
    "jiminy_text:gJiminyStoryTwilightTownLine10": "لكن أكسل ظهر، وحسناً،{END}",
    "jiminy_text:gJiminyStoryTwilightTownLine11": "لن نرى فاكسين مجدداً.{END}",
    "jiminy_text:gJiminyStoryTwilightTownLine12": "بقيادة صوت غامض، شق{END}",
    "jiminy_text:gJiminyStoryTwilightTownLine13": "ريكو طريقه عبر عوالم{END}",
    "jiminy_text:gJiminyStoryTwilightTownLine14": "البطاقات، لكنه قابل{END}",
    "jiminy_text:gJiminyRikuStoryTale2Line0": "فقط{END}",
    "jiminy_text:gJiminyRikuStoryTale2Line1": "كائنات{END}",
    "jiminy_text:gJiminyRikuStoryTale2Line2": "الظلام{END}",
    "jiminy_text:gJiminyRikuStoryTale2Line3": "في الداخل.{END}",
    "jiminy_text:gJiminyRikuStoryTale2Line4": "{END}"
  }
}