   "en": "…and I can’t even remember\nher name.{END}",
   "max_units": 52,
   "units": 42,
   "controls": [
    "{END}"
   ],
   "lines": 2
  },
  {
   "id": "event_text:gEvent021Text13",
   "pool": "event_text",
   "symbol": "gEvent021Text13",
   "en": "Sora…{END}",
   "max_units": 52,
   "units": 10,
   "controls": [
    "{END}"
   ],
   "lines": 1
  },
  {
   "id": "event_text:gEvent021Text14",
   "pool": "event_text",
   "symbol": "gEvent021Text14",
   "en": "Well, there’s no rush!{END}",
   "max_units": 52,
   "units": 27,
   "controls": [
    "{END}"
   ],
   "lines": 1
  },
  {
   "id": "event_text:gEvent021Text15",
   "pool": "event_text",
   "symbol": "gEvent021Text15",
   "en": "Let's keep going.\nYou’re bound to remember it,\njust like the rest!{END}",
   "max_units": 73,
