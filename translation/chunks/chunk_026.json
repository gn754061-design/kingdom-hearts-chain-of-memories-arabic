   "max_units": 52,
   "units": 28,
   "controls": [
    "{END}"
   ],
   "lines": 1
  },
  {
   "id": "event_text:gEvent121Text13",
   "pool": "event_text",
   "symbol": "gEvent121Text13",
   "en": "Old Phil’s prelim course was so\nhard, no one else could finish\nit.{END}",
   "max_units": 73,
