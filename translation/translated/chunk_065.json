    "jiminy_text:gJiminyCharacterGeppettoLine12": "الحوت{END}",
    "jiminy_text:gJiminyCharacterGeppettoLine13": "العملاق،{END}",
    "jiminy_text:gJiminyCharacterHerculesLine0": "وهربا{END}",
    "jiminy_text:gJiminyCharacterHerculesLine1": "بمساعدتنا.{END}",
