   ],
   "lines": 3
  },
  {
   "id": "card_message_text:gDonaldTalkText20",
   "pool": "card_message_text",
   "symbol": "gDonaldTalkText20",
   "en": "If you ask me, Vexen’s waiting\nto spring a trap on us!{END}",
   "max_units": 80,
   "units": 60,
   "controls": [
