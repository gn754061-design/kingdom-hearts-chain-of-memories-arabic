{
 "translations": {
  "jiminy_text:gJiminyCharacterMarluxiaLine4": "في محاولة لوضع المجموعة{END}",
  "jiminy_text:gJiminyCharacterMarluxiaLine5": "تحت سيطرته، استخدم مارلوكسيا{END}",
  "jiminy_text:gJiminyCharacterMarluxiaLine6": "ناميني للسيطرة على ذاكرة{END}",
  "jiminy_text:gJiminyCharacterMarluxiaLine7": "سورا{END}",
  "jiminy_text:gJiminyCharacterMarluxiaLine8": "ومحاولة{END}",
  "jiminy_text:gJiminyCharacterMarluxiaLine9": "الاستيلاء{END}",
  "jiminy_text:gJiminyCharacterAladdinLine0": "على{END}",
  "jiminy_text:gJiminyCharacterAladdinLine1": "قوة{END}",
  "jiminy_text:gJiminyCharacterAladdinLine2": "مفتاح القلب.{END}",
  "jiminy_text:gJiminyCharacterAladdinLine3": "{END}",
  "jiminy_text:gJiminyCharacterAladdinLine4": " {END}",
  "jiminy_text:gJiminyCharacterAladdinLine5": "أصبح علاء الدين سيد الجني{END}",
  "jiminy_text:gJiminyCharacterAladdinLine6": "عندما وجد المصباح{END}",
  "jiminy_text:gJiminyCharacterAladdinLine7": "السحري.{END}",
  "jiminy_text:gJiminyCharacterAladdinLine8": " {END}",
  "jiminy_text:gJiminyCharacterAladdinLine9": "في البداية أراد علاء الدين{END}",
  "jiminy_text:gJiminyCharacterAladdinLine10": "أن يصبح أميراً ويبهر{END}",
  "jiminy_text:gJiminyCharacterAladdinLine11": "ياسمين، لكن في النهاية منح{END}",
  "jiminy_text:gJiminyCharacterAladdinLine12": "الجني حريته{END}",
  "jiminy_text:gJiminyCharacterAladdinLine13": "وقرر{END}",
  "jiminy_text:gJiminyCharacterAladdinLine14": "أن{END}",
  "jiminy_text:gJiminyCharacterAladdinLine15": "يُظهر{END}",
  "jiminy_text:gJiminyCharacterGenieLine0": "لياسمين حقيقته.{END}",
  "jiminy_text:gJiminyCharacterGenieLine1": "{END}",
  "jiminy_text:gJiminyCharacterGenieLine2": " {END}",
  "jiminy_text:gJiminyCharacterGenieLine3": "على الجني أن يمنح حامل{END}",
  "jiminy_text:gJiminyCharacterGenieLine4": "المصباح ثلاث أمنيات.{END}",
  "jiminy_text:gJiminyCharacterGenieLine5": "{END}",
  "jiminy_text:gJiminyCharacterGenieLine6": " {END}",
  "jiminy_text:gJiminyCharacterGenieLine7": "يتوق إلى الحرية، لكن لا{END}",
  "jiminy_text:gJiminyCharacterGenieLine8": "يمكنه الحصول عليها إلا إذا{END}",
  "jiminy_text:gJiminyCharacterGenieLine9": "استخدم شخص ما{END}",
  "jiminy_text:gJiminyCharacterGenieLine10": "أمنية لتحريره.{END}",
  "jiminy_text:gJiminyCharacterJasmineLine0": "{END}",
  "jiminy_text:gJiminyCharacterJasmineLine1": " {END}",
  "jiminy_text:gJiminyCharacterJasmineLine2": "تشعر ياسمين بالاختناق في{END}",
  "jiminy_text:gJiminyCharacterJasmineLine3": "القصر، وتتوق{END}",
  "jiminy_text:gJiminyCharacterJasmineLine4": "إلى{END}",
  "jiminy_text:gJiminyCharacterJasmineLine5": "الحرية{END}",
  "jiminy_text:gJiminyCharacterIagoLine0": "خارج أسواره.{END}",
  "jiminy_text:gJiminyCharacterIagoLine1": "{END}",
  "jiminy_text:gJiminyCharacterIagoLine2": " {END}",
  "jiminy_text:gJiminyCharacterIagoLine3": "يطير ياغو في أگراباه،{END}",
  "jiminy_text:gJiminyCharacterIagoLine4": "ويعمل{END}",
  "jiminy_text:gJiminyCharacterIagoLine5": "كعين{END}",
  "jiminy_text:gJiminyCharacterIagoLine6": "وأذن{END}",
  "jiminy_text:gJiminyCharacterJafarLine0": "لجعفر الشرير.{END}",
  "jiminy_text:gJiminyCharacterJafarLine1": "{END}",
  "jiminy_text:gJiminyCharacterJafarLine2": " {END}",
  "jiminy_text:gJiminyCharacterJafarLine3": "سرق جعفر المصباح السحري{END}",
  "jiminy_text:gJiminyCharacterJafarLine4": "من علاء الدين، وبقوة{END}",
  "jiminy_text:gJiminyCharacterJafarLine5": "الجني، خطط{END}",
  "jiminy_text:gJiminyCharacterJafarLine6": "ليصبح{END}",
  "jiminy_text:gJiminyCharacterJafarLine7": "حاكم أگراباه.{END}",
  "jiminy_text:gJiminyCharacterJafarGenieLine0": "{END}",
  "jiminy_text:gJiminyCharacterJafarGenieLine1": " {END}",
  "jiminy_text:gJiminyCharacterJafarGenieLine2": "بعد أخذ المصباح السحري من{END}",
  "jiminy_text:gJiminyCharacterJafarGenieLine3": "علاء الدين، تمنى جعفر{END}",
  "jiminy_text:gJiminyCharacterJafarGenieLine4": "قوى{END}",
  "jiminy_text:gJiminyCharacterJafarGenieLine5": "الجني{END}",
  "jiminy_text:gJiminyCharacterJafarGenieLine6": "وحاول{END}",
  "jiminy_text:gJiminyCharacterJackLine0": "القضاء علينا.{END}",
  "jiminy_text:gJiminyCharacterJackLine1": "{END}",
  "jiminy_text:gJiminyCharacterJackLine2": " {END}",
  "jiminy_text:gJiminyCharacterJackLine3": "يبحث جاك دائماً عن طرق{END}",
  "jiminy_text:gJiminyCharacterJackLine4": "جديدة لجلب{END}",
  "jiminy_text:gJiminyCharacterJackLine5": "الرعب{END}",
  "jiminy_text:gJiminyCharacterJackLine6": "والقشعريرة{END}",
  "jiminy_text:gJiminyCharacterSallyLine0": "إلى الجميع.{END}",
  "jiminy_text:gJiminyCharacterSallyLine1": "{END}"
 }
}