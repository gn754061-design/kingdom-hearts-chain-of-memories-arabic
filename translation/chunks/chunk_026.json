   "max_units": 67,
   "units": 67,
   "controls": [
    "{END}"
   ],
   "lines": 4
  },
  {
   "id": "event_text:gEvent121Text33",
   "pool": "event_text",
   "symbol": "gEvent121Text33",
   "en": "GO!!{END}",
   "max_units": 52,
   "units": 9,
   "controls": [
    "{END}"
   ],
   "lines": 1
  },
  {
   "id": "event_text:gEvent122Text00",
   "pool": "event_text",
   "symbol": "gEvent122Text00",
