   "controls": [
    "{END}"
   ],
   "lines": 3
  },
  {
   "id": "card_message_text:gGoofyTalkText11",
   "pool": "card_message_text",
   "symbol": "gGoofyTalkText11",
   "en": "Naminé…  So that’s her name.\nAren’t you glad you finally\nremembered?{END}",
   "max_units": 80,
   "units": 75,
   "controls": [
    "{END}"
   ],
   "lines": 3
  },
  {
   "id": "card_message_text:gGoofyTalkText12",
   "pool": "card_message_text",
   "symbol": "gGoofyTalkText12",
   "en": "Any friend of yours is a friend\nof ours.  Let’s go help Naminé! {END}",
   "max_units": 80,
   "units": 70,
   "controls": [
    "{END}"
   ],
   "lines": 2
  },
  {
   "id": "card_message_text:gGoofyTalkText13",
   "pool": "card_message_text",
   "symbol": "gGoofyTalkText13",
   "en": "Gawrsh, what coulda\nhappened to make Riku talk like\nthat?{END}",
