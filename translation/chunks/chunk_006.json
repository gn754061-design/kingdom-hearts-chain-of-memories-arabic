   "units": 64,
   "controls": [
    "{END}"
   ],
   "lines": 3
  },
  {
   "id": "card_message_text:gGoofyTalkText14",
   "pool": "card_message_text",
   "symbol": "gGoofyTalkText14",
   "en": "It sure is nice to have the\nhappy Sora back.{END}",
   "max_units": 80,
   "units": 50,
   "controls": [
