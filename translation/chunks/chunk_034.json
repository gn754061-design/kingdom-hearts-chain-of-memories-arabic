   "controls": [
    "{END}"
   ],
   "lines": 3
  },
  {
   "id": "event_text:gEvent025Text07",
   "pool": "event_text",
   "symbol": "gEvent025Text07",
   "en": "You know her?!{END}",
   "max_units": 52,
   "units": 19,
   "controls": [
    "{END}"
   ],
   "lines": 1
  },
  {
   "id": "event_text:gEvent025Text08",
   "pool": "event_text",
   "symbol": "gEvent025Text08",
