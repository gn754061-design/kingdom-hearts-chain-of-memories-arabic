   "controls": [
    "{END}"
   ],
   "lines": 4
  },
  {
   "id": "event_text:gEvent026Text00",
   "pool": "event_text",
   "symbol": "gEvent026Text00",
   "en": "I’M a bad guy, so you have to\ngo though me!{END}",
